# Copy to .env and fill in. Do not commit .env
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Set to 1 only if DeepSeek must go through a system proxy; off by default
# DEEPSEEK_TRUST_ENV=0

# Optional: API gateway auth
# DEMO_API_KEY=
# DEMO_CORS_ORIGINS=*
