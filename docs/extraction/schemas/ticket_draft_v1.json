{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket_draft_v1",
  "title": "ticket_draft_v1",
  "description": "Extraction · smart ticket draft (F-SVC-001 / skill ticket_fields)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_type",
    "ticket_channel",
    "ticket_status",
    "tag_id",
    "sentiment",
    "desc_text",
    "is_complaint"
  ],
  "properties": {
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CUS-\\d+$",
      "description": "Customer ID; null if not extracted; set needs_human_review=true when null"
    },
    "vin": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^QS0[A-Z0-9]{14}$",
      "description": "Synthetic VIN; null if not extracted"
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "fault",
        "consult",
        "complaint",
        "other"
      ]
    },
    "fault_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "battery",
        "motor",
        "brake",
        "controller",
        "charging",
        "dashboard",
        "frame",
        "lighting",
        "tire",
        "other",
        null
      ]
    },
    "consult_category": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "ticket_channel": {
      "type": "string",
      "enum": [
        "400",
        "App",
        "e-commerce",
        "store",
        "community"
      ]
    },
    "ticket_status": {
      "type": "string",
      "enum": [
        "open",
        "processing",
        "closed"
      ],
      "default": "open"
    },
    "tag_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must be a TagVocabulary tag_id"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "pos",
        "neu",
        "neg"
      ]
    },
    "desc_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "is_complaint": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_human_review": {
      "type": "boolean"
    }
  }
}
